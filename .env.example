# Motor de voz: kokoro (padrão, rápido em CPU), voxcpm (mais natural, ~25x mais lento em CPU;
# exige a imagem construída com WITH_VOXCPM=true) ou mock (bipes, para desenvolvimento)
TTS_ENGINE=kokoro

# --- Kokoro: arquivos baixados sozinhos para data/app/models/kokoro na primeira subida
# fp32 (326 MB). O int8 (kokoro-v1.0.int8.onnx, 114 MB) foi 10x mais lento no teste local.
KOKORO_MODEL=kokoro-v1.0.onnx
KOKORO_VOICES=voices-v1.0.bin

# --- VoxCPM (só com TTS_ENGINE=voxcpm)
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_DEVICE=cpu
# auto = float32 em CPU: ~3,6x mais rápido que bfloat16 sem AMX/AVX-512 BF16, mas ~10 GB de RAM.
# Com 8 GB de RAM, ou em CPU com AMX (Xeon Sapphire Rapids+), use bfloat16.
VOXCPM_DTYPE=auto
# Menos passos = síntese mais rápida e um pouco menos natural (padrão do modelo: 10)
VOXCPM_TIMESTEPS=10
VOXCPM_CFG=2.0
# Núcleos para o torch (0 = todos)
TORCH_THREADS=0

# OCR só é necessário para PDFs escaneados e imagens; em CPU é a etapa mais lenta
DOCLING_OCR=false
DOCLING_TABLES=true

# Demo: 10 MB sobe em <60 s (limite de leitura do Traefik v3) a partir de ~1,5 Mbps de upload.
MAX_UPLOAD_MB=10
MAX_SEGMENT_CHARS=280
MAX_PREFETCH=6
AUDIO_FORMAT=mp3

# Traefik (lidos pelo docker compose para montar as labels)
TRAEFIK_HOST=leitor.seudominio.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Senha de acesso (HTTP Basic, qualquer usuário). Deixe vazio só atrás de outra autenticação.
APP_PASSWORD=
