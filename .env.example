# Motor de voz: voxcpm (produção) ou mock (desenvolvimento, sem baixar o modelo)
TTS_ENGINE=voxcpm
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_DEVICE=cpu
# Menos passos = síntese mais rápida e um pouco menos natural (padrão do modelo: 10)
VOXCPM_TIMESTEPS=10
VOXCPM_CFG=2.0
# Núcleos para o torch (0 = todos)
TORCH_THREADS=0

# OCR só é necessário para PDFs escaneados e imagens; em CPU é a etapa mais lenta
DOCLING_OCR=false
DOCLING_TABLES=true

# Demo: 10 MB sobe em <60 s (limite de leitura do Traefik v3) a partir de ~1,5 Mbps de upload.
MAX_UPLOAD_MB=10
MAX_SEGMENT_CHARS=280
MAX_PREFETCH=6
AUDIO_FORMAT=mp3

# Traefik (lidos pelo docker compose para montar as labels)
TRAEFIK_HOST=leitor.seudominio.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Senha de acesso (HTTP Basic, qualquer usuário). Deixe vazio só atrás de outra autenticação.
APP_PASSWORD=
